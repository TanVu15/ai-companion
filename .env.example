# Sao chép file này thành ".env" rồi điền key của bạn. KHÔNG đưa file .env lên GitHub.
ANTHROPIC_API_KEY=
MODEL=claude-haiku-5-5

# Đặt DEMO=1 để xem giao diện mà chưa cần API key (bot chỉ nhắc lại lời bạn)
DEMO=0

# Giới hạn để không lỡ tiêu quá nhiều tiền API
HISTORY_LIMIT=20
DAILY_LIMIT=300
# Gom 20 tin nhắn cũ thành 1 đoạn tóm tắt (tốn thêm 1 câu API mỗi lần gom)
SUMMARY_BATCH=20

# Mật khẩu vào web. NÊN đặt khi dùng Bơ ngoài mạng nhà (xem DUA_LEN_MANG.md). Để trống = không hỏi.
APP_PASSWORD=

# Khóa cho thiết bị phần cứng (ESP32) gọi Bơ, xem THIET_BI.md. Để trống = tắt cổng thiết bị.
DEVICE_KEY=

# Giá API (đô la / 1 triệu token) để ước tính chi phí trong nút "Chi phí". Kiểm tra giá mới trên trang Anthropic.
PRICE_INPUT_PER_MTOK=1
PRICE_OUTPUT_PER_MTOK=5
# Ngân sách mỗi tháng (đô la). Tiêu tới mức này thì Bơ nghỉ tới tháng sau. 0 = không giới hạn.
MONTHLY_USD_LIMIT=5
# Lâu ngần này ngày không nói chuyện thì Bơ chủ động chào "lâu quá không gặp". 0 = tắt.
GREET_MISS_DAYS=2
# Tối Chủ nhật Bơ điểm lại tuần qua (1 câu API/tuần). 0 = tắt
WEEKLY_RECAP=1
# Ngày lễ (Tết, Trung thu, 20/10...) mở web thì Bơ chủ động chúc (1 câu API mỗi ngày lễ). 0 = tắt.
CHUC_LE=1

# Mỗi ngày tự sao lưu trí nhớ vào data/sao_luu/, giữ 7 bản gần nhất. 0 = tắt.
TU_SAO_LUU=1
SAO_LUU_GIU=7

# Tối còn thói quen chưa làm thì Bơ nhắc nhẹ một lần lúc giờ này (không tốn API). Để trống = tắt.
NHAC_THOI_QUEN=20:30
# Giờ yên lặng: Bơ không tự đọc to lời nhắc/lời chào trong khoảng giờ này (vẫn hiện chữ). Để trống = tắt
GIO_YEN_LANG=23-6
# Thành phố để Bơ biết thời tiết (miễn phí, không cần tài khoản). Ví dụ: THANH_PHO=Da Nang. Để trống = tắt
THANH_PHO=
